{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MkChad terminal deployment result schema 1",
  "type": "object",
  "required": ["schema", "run_id", "release", "started_at", "completed_at", "outcome", "phase", "components", "artifact", "actions", "configuration_handoff", "failed_step", "diagnostic", "log_path"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": 1},
    "run_id": {"type": "string", "format": "uuid"},
    "release": {"type": "string", "pattern": "^(?!-)(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9._/-]*$"},
    "started_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "completed_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "outcome": {"enum": ["succeeded", "failed", "interrupted"]},
    "phase": {"enum": ["preflight", "apply", "verify"]},
    "components": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {"$ref": "#/$defs/component"},
      "allOf": [
        {"contains": {"properties": {"name": {"const": "msk_containers"}}}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"name": {"const": "container_tools"}}}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"name": {"const": "mkchad"}}}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"name": {"const": "opencode-db"}}}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"name": {"const": "opencode"}}}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"name": {"const": "opencode.nvim"}}}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"name": {"const": "opencode-project-reload"}}}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"name": {"const": "compound-engineering"}}}, "minContains": 1, "maxContains": 1}
      ]
    },
    "artifact": {"$ref": "#/$defs/artifact"},
    "actions": {"type": "array", "items": {"$ref": "#/$defs/action"}},
    "configuration_handoff": {"$ref": "#/$defs/configuration_handoff"},
    "failed_step": {"type": ["string", "null"], "minLength": 1, "maxLength": 256},
    "diagnostic": {"type": "string", "minLength": 1, "maxLength": 4096},
    "log_path": {"type": "string", "pattern": "^/[^\\u0000]+$"}
  },
  "$defs": {
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "repository": {"type": "string", "pattern": "^(git@github\\.com:|https://github\\.com/)[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+(\\.git)?$"},
    "component": {
      "type": "object",
      "required": ["name", "disposition", "requested_commit", "observed_commit"],
      "additionalProperties": false,
      "properties": {
        "name": {"enum": ["msk_containers", "container_tools", "mkchad", "opencode-db", "opencode", "opencode.nvim", "opencode-project-reload", "compound-engineering"]},
        "disposition": {"enum": ["deployed", "embedded", "configuration-owned"]},
        "requested_commit": {"$ref": "#/$defs/commit"},
        "observed_commit": {"oneOf": [{"$ref": "#/$defs/commit"}, {"type": "null"}]}
      }
    },
    "artifact": {
      "type": "object",
      "required": ["architecture", "expected_sha256", "observed_sha256"],
      "additionalProperties": false,
      "properties": {
        "architecture": {"enum": ["x86_64", "aarch64", "ppc64le"]},
        "expected_sha256": {"$ref": "#/$defs/digest"},
        "observed_sha256": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]}
      }
    },
    "action": {
      "type": "object",
      "required": ["component", "id", "phase", "status"],
      "additionalProperties": false,
      "properties": {
        "component": {"enum": ["msk_containers", "container_tools", "mkchad", "opencode-db"]},
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "phase": {"enum": ["preflight", "apply", "verify"]},
        "status": {"enum": ["pending", "succeeded", "skipped-compliant", "failed"]}
      }
    },
    "configuration_handoff": {
      "type": "object",
      "required": ["state", "contract_version", "guidance", "components"],
      "additionalProperties": false,
      "properties": {
        "state": {"const": "configuration-pending"},
        "contract_version": {"const": 1},
        "guidance": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"},
        "components": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/handoff_component"}}
      }
    },
    "handoff_component": {
      "type": "object",
      "required": ["name", "repository", "commit"],
      "additionalProperties": false,
      "properties": {
        "name": {"enum": ["opencode.nvim", "opencode-project-reload", "compound-engineering"]},
        "repository": {"$ref": "#/$defs/repository"},
        "commit": {"$ref": "#/$defs/commit"}
      }
    }
  }
}
