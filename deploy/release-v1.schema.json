{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MkChad release metadata schema 1",
  "type": "object",
  "required": ["schema", "components", "artifacts", "configuration"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": 1},
    "components": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "required": ["name", "disposition"],
        "properties": {
          "name": {"enum": ["msk_containers", "mkchad", "opencode", "opencode.nvim", "opencode-project-reload", "compound-engineering", "opencode_sprint_loop"]},
          "disposition": {"enum": ["deployed", "embedded", "configuration-owned", "disabled"]},
          "destination": {
            "type": "object",
            "required": ["root", "path"],
            "additionalProperties": false,
            "properties": {"root": {"enum": ["home", "xdg_config_home", "xdg_data_home", "xdg_state_home"]}, "path": {"type": "string", "minLength": 1}}
          },
          "actions": {"type": "array"}
        }
      }
    },
    "artifacts": {
      "type": "object",
      "required": ["nvim-image"],
      "additionalProperties": false,
      "properties": {"nvim-image": {"type": "array", "minItems": 1}}
    },
    "configuration": {
      "type": "object",
      "required": ["contract_version", "guidance"],
      "additionalProperties": false,
      "properties": {"contract_version": {"const": 1}, "guidance": {"type": "string", "minLength": 1}}
    }
  }
}
