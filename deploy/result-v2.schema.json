{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MkChad terminal deployment result schema 2",
  "type": "object",
  "required": ["schema", "run_id", "release", "started_at", "completed_at", "outcome", "phase", "components", "artifact", "packages", "actions", "configuration_handoff", "failed_step", "diagnostic", "log_path"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": 2},
    "run_id": {"type": "string", "format": "uuid"},
    "release": {"type": "string", "pattern": "^(?!-)(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9._/-]*$"},
    "started_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "completed_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "outcome": {"enum": ["succeeded", "failed", "interrupted"]},
    "phase": {"enum": ["preflight", "apply", "verify"]},
    "components": {"type": "array", "minItems": 9, "maxItems": 9},
    "artifact": {"$ref": "#/$defs/artifact"},
    "packages": {"$ref": "#/$defs/packages"},
    "actions": {"type": "array", "items": {"$ref": "#/$defs/action"}},
    "configuration_handoff": {"$ref": "#/$defs/configuration_handoff"},
    "failed_step": {"type": ["string", "null"], "minLength": 1, "maxLength": 256},
    "diagnostic": {"type": "string", "minLength": 1, "maxLength": 4096},
    "log_path": {"type": "string", "pattern": "^/[^\\u0000]+$"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "identity": {"type": "object", "required": ["role", "architecture", "version", "product_major", "source_commit", "sha256", "libc", "source_filename_class"], "additionalProperties": false, "properties": {"role": {"enum": ["host", "container"]}, "architecture": {"enum": ["x86_64", "aarch64", "ppc64le"]}, "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z]+(?:[.-][0-9A-Za-z]+)*)?$"}, "product_major": {"type": "integer", "minimum": 0}, "source_commit": {"$ref": "#/$defs/commit"}, "sha256": {"$ref": "#/$defs/digest"}, "libc": {"enum": ["musl", "glibc"]}, "source_filename_class": {"const": "container-tools-package"}}},
    "packages": {"type": "object", "required": ["expected", "observed"], "additionalProperties": false, "properties": {"expected": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/identity"}}, "observed": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"oneOf": [{"$ref": "#/$defs/identity"}, {"type": "null"}]}}}},
    "artifact": {"type": "object", "required": ["architecture", "expected_sha256", "observed_sha256"], "additionalProperties": false, "properties": {"architecture": {"enum": ["x86_64", "aarch64", "ppc64le"]}, "expected_sha256": {"$ref": "#/$defs/digest"}, "observed_sha256": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]}}},
    "action": {"type": "object", "required": ["component", "id", "phase", "status"], "additionalProperties": false, "properties": {"component": {"enum": ["msk_containers", "container_tools", "mkchad", "opencode-db"]}, "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}, "phase": {"enum": ["preflight", "apply", "verify"]}, "status": {"enum": ["pending", "succeeded", "skipped-compliant", "failed"]}}},
    "configuration_handoff": {"type": "object", "required": ["state", "contract_version", "guidance", "components"], "additionalProperties": false, "properties": {"state": {"const": "configuration-pending"}, "contract_version": {"const": 1}, "guidance": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"}, "components": {"type": "array", "minItems": 3, "maxItems": 3}}}
  }
}
