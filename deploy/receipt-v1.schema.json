{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MkChad deployment receipt schema 1",
  "type": "object",
  "required": ["schema", "id", "deployer", "state", "phase", "authority", "components", "artifact", "actions", "configuration_handoff", "recovery", "process_cleanup", "diagnostic"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": 1},
    "id": {"type": "string"},
    "deployer": {"const": "mkchad-deploy-v1"},
    "state": {"enum": ["in_progress", "failed", "succeeded", "recovered_complete", "recovered_restore"]},
    "phase": {"type": "string"},
    "authority": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "tag", "tag_object", "parent_commit"],
          "additionalProperties": false,
          "properties": {
            "kind": {"const": "annotated-tag-plus-sha"},
            "tag": {"type": "string", "pattern": "^(?!-)(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9._/-]*$"},
            "tag_object": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "parent_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
          }
        },
        {
          "type": "object",
          "required": ["kind", "parent_commit"],
          "additionalProperties": false,
          "properties": {
            "kind": {"const": "development-sha"},
            "parent_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
          }
        }
      ]
    },
    "components": {"type": "array"},
    "artifact": {"type": "object"},
    "actions": {"type": "array"},
    "configuration_handoff": {
      "type": "object",
      "required": ["contract_version", "guidance", "components"],
      "additionalProperties": false,
      "properties": {
        "contract_version": {"const": 1},
        "guidance": {"type": "string", "minLength": 1},
        "components": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "allOf": [
            {"contains": {"type": "object", "properties": {"name": {"const": "opencode.nvim"}}, "required": ["name"]}, "minContains": 1, "maxContains": 1},
            {"contains": {"type": "object", "properties": {"name": {"const": "opencode-project-reload"}}, "required": ["name"]}, "minContains": 1, "maxContains": 1},
            {"contains": {"type": "object", "properties": {"name": {"const": "compound-engineering"}}, "required": ["name"]}, "minContains": 1, "maxContains": 1}
          ],
          "items": {
            "type": "object",
            "required": ["name", "repository", "revision"],
            "additionalProperties": false,
            "properties": {
              "name": {"enum": ["opencode.nvim", "opencode-project-reload", "compound-engineering"]},
              "repository": {"type": "string", "pattern": "^github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
              "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
            }
          }
        }
      }
    },
    "recovery": {"type": "object"},
    "process_cleanup": {
      "type": "object",
      "required": ["machine_observed", "operator_asserted"],
      "additionalProperties": false,
      "properties": {
        "machine_observed": {"type": "boolean"},
        "operator_asserted": {"type": "boolean"}
      }
    },
    "diagnostic": {"type": "string"}
  }
}
